{
  "name": "@infamous-freight/api",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Infaemous-Freight/Infamous-freight.git",
    "directory": "apps/api"
  },
  "type": "commonjs",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start:dev": "tsx watch src/server.ts",
    "start:prod": "node dist/src/server.js",
    "test": "node scripts/run-jest.cjs --runInBand",
    "test:coverage": "node scripts/run-jest.cjs --runInBand --coverage",
    "lint": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "prisma:generate": "pnpm exec prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "7.8.0",
    "@prisma/extension-accelerate": "3.0.1",
    "@sentry/node": "^10.51.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "openai": "^6.36.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "prisma": "7.8.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3"
  }
}

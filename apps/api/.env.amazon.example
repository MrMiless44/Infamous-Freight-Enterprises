# Amazon Delivery / SP-API integration for Infamous Freight
# Keep dry run enabled until Amazon production app approval, IAM, roles, and seller authorization are complete.
AMAZON_DELIVERY_DRY_RUN=true

# North America default endpoint. Use EU/FE endpoints only for the corresponding marketplace/region.
SP_API_ENDPOINT=https://sellingpartnerapi-na.amazon.com
SP_API_REGION=us-east-1
SP_API_MARKETPLACE_ID=ATVPDKIKX0DER
SP_API_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token

# Login With Amazon credentials from SP-API app registration.
SP_API_LWA_CLIENT_ID=
SP_API_LWA_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=

# AWS credentials allowed to sign SP-API execute-api requests.
SP_API_AWS_ACCESS_KEY_ID=
SP_API_AWS_SECRET_ACCESS_KEY=
SP_API_AWS_SESSION_TOKEN=

# Copy to apps/api/.env only if you need API-specific overrides.
# The Prisma config also loads ../../.env by default.

DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
PORT=3000
WEB_APP_URL=http://localhost:5173
SITE_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=ws://localhost:3000
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_ENABLED=true

# Auth defaults to trusted mode in production and header mode for local tests.
# Do not enable header mode in production.
AUTH_MODE=trusted
SUPABASE_JWT_SECRET=<supabase-jwt-secret>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Optional: enforce the expected JWT audience when verifying bearer tokens.
# Supabase access tokens normally use aud=authenticated.
SUPABASE_JWT_AUDIENCE=authenticated

# Optional: API runtime error tracking
SENTRY_DSN=https://<public-key>@o<org>.ingest.us.sentry.io/<project-id>
VITE_SENTRY_DSN=https://<public-key>@o<org>.ingest.us.sentry.io/<project-id>
NEXT_PUBLIC_SENTRY_DSN=https://<public-key>@o<org>.ingest.us.sentry.io/<project-id>
VITE_SENTRY_ENABLED=false

# Optional: Stripe URLs/keys when API routes create checkout/portal sessions
STRIPE_ACCOUNT_ID=acct_<stripe-account-id>
STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key>
VITE_STRIPE_PUBLIC_KEY=<stripe-publishable-key>
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/settings?checkout=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/settings?checkout=canceled
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/settings

# Optional: Redis
REDIS_URL=redis://:<password>@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>
REDIS_DB=0

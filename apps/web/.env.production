# Infamous Freight - Frontend Production Environment
# These values are baked into the build at compile time

# API & Services
# Leave VITE_API_URL unset (empty) to route API calls through the Netlify
# /api/* reverse-proxy to https://infamous-freight.fly.dev.
# Set to an absolute URL (e.g. https://api.infamousfreight.com) only if you
# want to bypass the proxy and call the backend directly.
VITE_API_URL=
# Supabase credentials must be provided via Netlify env vars
# (VITE_SUPABASE_URL & VITE_SUPABASE_ANON_KEY or VITE_SUPABASE_PUBLISHABLE_KEY).
# Do NOT put placeholder values here — Vite bakes .env.production values into the
# bundle, and a truthy placeholder prevents the || fallback chain in useSupabase.ts
# from reaching the real key.

# Stripe publishable key must be provided via Netlify env vars.
# VITE_STRIPE_PUBLIC_KEY=

# Feature Flags
VITE_ENABLE_VOICE=true
VITE_ENABLE_AUCTION=true
VITE_ENABLE_ANALYTICS=true
VITE_APP_VERSION=1.0.0

# Sentry DSN must be provided via Netlify env vars.
# VITE_SENTRY_DSN=

